# Security configuration for QRdoklad
parameters:
	security:
		# Session security
		sessionName: 'QRDOKLAD_SECURE'
		sessionTimeout: '1 hour'
		
		# ✅ CSRF protection - rozšířená konfigurace
		csrfProtection: true
		csrfExpiration: 3600  # 1 hodina
		csrfTokenName: '_token_'
		
		# Rate limiting for forms
		rateLimitRequests: 100
		rateLimitWindow: 300  # 5 minutes
		formRateLimit: 30     # 30 sekund mezi odesláními stejného formuláře
		
		# Password security (pro budoucí použití)
		passwordMinLength: 8
		passwordRequireSpecialChar: true
		passwordRequireNumber: true
		
		# File upload security
		allowedMimeTypes: ['image/jpeg', 'image/png', 'image/gif', 'application/pdf']
		maxFileSize: 10485760  # 10MB
		
		# IP restrictions (pro admin access)
		adminAllowedIPs: []  # Empty = allow all, add IPs for restriction
		
		# Content Security Policy
		csp:
			defaultSrc: "'self'"
			scriptSrc: "'self' 'unsafe-inline' https://cdn.jsdelivr.net https://www.googletagmanager.com"
			styleSrc: "'self' 'unsafe-inline' https://cdn.jsdelivr.net"
			imgSrc: "'self' data: https:"
			fontSrc: "'self' https://cdn.jsdelivr.net"
			connectSrc: "'self' https://www.google-analytics.com"

session:
	autoStart: false
	expiration: '1 hour'
	name: QRDOKLAD_SECURE
	cookieHttponly: true
	cookieSecure: auto
	cookieSamesite: Strict
	cookiePath: /
	cookieDomain: 
	# ✅ Bezpečnostní nastavení session
	gcProbability: 1
	gcDivisor: 100
	gcMaxlifetime: 3600

http:
	# ✅ Rozšířené Security headers
	headers:
		X-Content-Type-Options: nosniff
		X-Frame-Options: DENY
		X-XSS-Protection: "1; mode=block"
		Referrer-Policy: strict-origin-when-cross-origin
		Permissions-Policy: "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security: "max-age=31536000; includeSubDomains"
		# Content-Security-Policy se nastaví dynamicky v presenteru