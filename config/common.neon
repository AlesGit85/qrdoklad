# see https://doc.nette.org/en/configuring

parameters:


includes:
	- security.neon


application:
	errorPresenter:
		4xx: Error:Error4xx
		5xx: Error:Error5xx
	mapping: App\Presentation\*\**Presenter


database:
	dsn: 'sqlite::memory:'
	user:
	password:


latte:
	strictTypes: yes
	strictParsing: yes
	extensions:
		- App\Presentation\Accessory\LatteExtension


assets:
	mapping:
		default:
			path: assets
			# type: vite  # Uncomment to activate Vite for asset building


di:
	export:
		parameters: no
		tags: no


security:
	# users:
		# admin: secret # user 'admin', password 'secret'
	roles:
		guest:
		user:
		admin:

# ✅ Registrace vlastních služeb pro zabezpečení
services:
	# SecurityHelper pro bezpečnostní operace
	securityHelper: App\Core\SecurityHelper
	
	# EmailService pro správu emailů
	emailService: App\Core\EmailService
	
	# ✅ KROK 2: TestMailer pro lokální vývoj (ukládání do souborů)
	mail.mailer: App\Core\TestMailer(%tempDir%)