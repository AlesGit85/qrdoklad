<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    
    <!-- SEO Meta tagy -->
    <title>{ifset pageTitle}{$pageTitle}{else}QRdoklad - Moderní fakturační systém s QR platbami{/ifset}</title>
    <meta name="description" content="{ifset metaDescription}{$metaDescription}{else}Profesionální fakturační systém s QR platbami, automatickým ARES vyhledáváním a pokročilými funkcemi pro české firmy. Registrace zdarma!{/ifset}">
    <meta name="keywords" content="{ifset metaKeywords}{$metaKeywords}{else}fakturační systém, QR platby, ARES, fakturace, účetnictví, podnikání, Česká republika{/ifset}">
    <meta name="robots" content="index, follow">
    <meta name="author" content="QRdoklad - Aleš Zita">
    
    <!-- Open Graph -->
    <meta property="og:title" content="{ifset pageTitle}{$pageTitle}{else}QRdoklad - Moderní fakturační systém{/ifset}">
    <meta property="og:description" content="{ifset metaDescription}{$metaDescription}{else}Profesionální fakturační systém s QR platbami pro české firmy{/ifset}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{$currentUrl}">
    <meta property="og:image" content="{$baseUrl}/images/og-image.jpg">
    <meta property="og:locale" content="cs_CZ">
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{ifset pageTitle}{$pageTitle}{else}QRdoklad - Moderní fakturační systém{/ifset}">
    <meta name="twitter:description" content="{ifset metaDescription}{$metaDescription}{else}Profesionální fakturační systém s QR platbami{/ifset}">
    <meta name="twitter:image" content="{$baseUrl}/images/og-image.jpg">
    
    <!-- Favicon -->
    <link rel="icon" href="{$basePath}/favicon.ico" type="image/x-icon">
    <link rel="apple-touch-icon" href="{$basePath}/images/apple-touch-icon.png">
    
    <!-- Canonical URL -->
    <link rel="canonical" href="{$currentUrl}">
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    
    <!-- Vlastní CSS -->
    <link rel="stylesheet" href="{$basePath}/css/landing.css">
    
    <!-- Structured Data -->
    {ifset structuredData}
        <script type="application/ld+json">{$structuredData|noescape}</script>
    {/ifset}
    
    {ifset organizationSchema}
        <script type="application/ld+json">{$organizationSchema|noescape}</script>
    {/ifset}
    
    {ifset pageSchema}
        <script type="application/ld+json">{$pageSchema|noescape}</script>
    {/ifset}
</head>

<body>
    <!-- Navigace -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
        <div class="container">
            <a class="navbar-brand" n:href="Landing:default">
                <img src="{$basePath}/images/logo.svg" alt="QRdoklad" height="30">
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a n:href="Landing:default" n:class="nav-link, $presenter->action === 'default' ? active">
                            <i class="bi bi-house-fill"></i> Domů
                        </a>
                    </li>
                    <li class="nav-item">
                        <a n:href="Landing:funkce" n:class="nav-link, $presenter->action === 'funkce' ? active">
                            <i class="bi bi-gear-fill"></i> Funkce
                        </a>
                    </li>
                    <li class="nav-item">
                        <a n:href="Landing:cenik" n:class="nav-link, $presenter->action === 'cenik' ? active">
                            <i class="bi bi-currency-dollar"></i> Ceník
                        </a>
                    </li>
                    <li class="nav-item">
                        <a n:href="Landing:kontakt" n:class="nav-link, $presenter->action === 'kontakt' ? active">
                            <i class="bi bi-envelope-fill"></i> Kontakt
                        </a>
                    </li>
                </ul>
                
                <div class="navbar-nav">
                    <a href="https://app.qrdoklad.cz/sign/up" class="btn btn-primary me-2">
                        <i class="bi bi-rocket"></i> Registrace
                    </a>
                    <a href="https://app.qrdoklad.cz/sign/in" class="btn btn-outline-light">
                        <i class="bi bi-box-arrow-in-right"></i> Přihlášení
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hlavní obsah -->
    <main>
        {include content}
    </main>

    <!-- Footer -->
    <footer class="footer bg-dark text-light py-5">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 mb-4">
                    <div class="footer-brand mb-4">
                        <img src="{$basePath}/images/logo.svg" alt="QRdoklad" height="40" class="mb-3">
                        <p class="text-light-50">
                            Moderní fakturační systém s QR platbami pro české podnikatele. 
                            Základní funkce navždy zdarma.
                        </p>
                    </div>
                    
                    <div class="footer-social">
                        <a href="#" class="social-link me-3" title="Facebook">
                            <i class="bi bi-facebook"></i>
                        </a>
                        <a href="#" class="social-link me-3" title="Twitter">
                            <i class="bi bi-twitter"></i>
                        </a>
                        <a href="#" class="social-link me-3" title="LinkedIn">
                            <i class="bi bi-linkedin"></i>
                        </a>
                        <a href="#" class="social-link" title="YouTube">
                            <i class="bi bi-youtube"></i>
                        </a>
                    </div>
                </div>
                
                <!-- Produkt -->
                <div class="col-lg-2 col-md-6 mb-4">
                    <h6 class="text-primary mb-3">Produkt</h6>
                    <ul class="list-unstyled">
                        <li><a n:href="Landing:funkce" class="text-light-50">Funkce</a></li>
                        <li><a n:href="Landing:cenik" class="text-light-50">Ceník</a></li>
                        <li><a n:href="Landing:changelog" class="text-light-50">Changelog</a></li>
                        <li><a n:href="Landing:api" class="text-light-50">API dokumentace</a></li>
                    </ul>
                </div>
                
                <!-- Podpora -->
                <div class="col-lg-2 col-md-6 mb-4">
                    <h6 class="text-primary mb-3">Podpora</h6>
                    <ul class="list-unstyled">
                        <li><a n:href="Landing:docs" class="text-light-50">Dokumentace</a></li>
                        <li><a n:href="Landing:help" class="text-light-50">Nápověda</a></li>
                        <li><a n:href="Landing:faq" class="text-light-50">FAQ</a></li>
                        <li><a n:href="Landing:status" class="text-light-50">Status</a></li>
                    </ul>
                </div>
                
                <!-- Právní -->
                <div class="col-lg-2 col-md-6 mb-4">
                    <h6 class="text-primary mb-3">Právní</h6>
                    <ul class="list-unstyled">
                        <li><a n:href="Landing:terms" class="text-light-50">Obchodní podmínky</a></li>
                        <li><a n:href="Landing:privacy" class="text-light-50">Ochrana osobních údajů</a></li>
                    </ul>
                </div>
                
                <!-- Společnost -->
                <div class="col-lg-2 col-md-6 mb-4">
                    <h6 class="text-primary mb-3">Společnost</h6>
                    <ul class="list-unstyled">
                        <li><a n:href="Landing:about" class="text-light-50">O QRdokladu</a></li>
                        <li><a n:href="Landing:blog" class="text-light-50">Blog</a></li>
                        <li><a n:href="Landing:kontakt" class="text-light-50">Kontakt</a></li>
                    </ul>
                </div>
            </div>
            
            <hr class="my-4 border-secondary">
            
            <div class="row align-items-center">
                <div class="col-md-6">
                    <p class="mb-0 text-light-50">&copy; {date('Y')} QRdoklad. Všechna práva vyhrazena.</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <p class="mb-0 text-light-50">
                        Vyvinuto s <i class="bi bi-heart-fill text-danger"></i> v České republice od <a href="https://allimedia.cz" target="_blank" class="text-light-50">Allimedia.cz</a>.
                    </p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- QRdoklad JS - vyčištěná modulární struktura -->
    <!-- 📝 POZNÁMKA: Načítáme pouze existující soubory v správném pořadí -->
    
    <!-- 1. UI efekty (scroll animace, navbar, smooth scrolling, lightbox) -->
    <script src="{$basePath}/js/ui-effects.js"></script>
    
    <!-- 2. Pricing funkce (toggle, kalkulačka) -->
    <script src="{$basePath}/js/pricing.js"></script>
    
    <!-- 3. Formulářové funkce (kontakt, validace) -->
    <script src="{$basePath}/js/form-handler.js"></script>
    
    <!-- 4. Nakonec hlavní inicializační soubor -->
    <script src="{$basePath}/js/landing.js"></script>
    
    <!-- 5. Dokumentace JS (jen pro docs stránky) -->
    {if $presenter->action === 'docs'}
        <script src="{$basePath}/js/docs.js"></script>
    {/if}

    <!-- Scroll to Top tlačítko -->
    <button id="scrollToTop" class="scroll-to-top" aria-label="Scroll to top" title="Zpět nahoru">
        <i class="bi bi-arrow-up"></i>
    </button>
    
</body>
</html>